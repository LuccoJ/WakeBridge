<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="96dp"
    android:paddingEnd="28dp"
    android:paddingBottom="56dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_night"
        app:tint="@color/on_night_soft" />

    <TextView
        android:id="@+id/ring_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/on_night"
        android:textSize="88sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ring_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/on_night" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/ring_text"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/on_night_soft" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/ring_stop"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:backgroundTint="@color/accent_pastel"
        android:text="@string/stop"
        android:textColor="@color/on_accent_pastel"
        android:textSize="18sp" />

    <Button
        android:id="@+id/ring_snooze"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:text="@string/snooze"
        android:textColor="@color/on_night" />
</LinearLayout>
