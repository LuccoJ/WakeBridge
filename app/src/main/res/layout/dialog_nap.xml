<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/nap_length"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <com.google.android.material.slider.Slider
        android:id="@+id/nap_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/nap_length_description"
        android:stepSize="5"
        android:valueFrom="5"
        android:valueTo="180"
        app:labelBehavior="gone" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/nap_sleep_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sleep_only_title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sleep_only_summary"
        android:textAppearance="?attr/textAppearanceBodySmall" />
</LinearLayout>
