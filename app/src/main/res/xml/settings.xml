<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/settings_watch_category">
        <Preference
            app:key="watch"
            app:icon="@drawable/ic_pref_watch"
            app:title="@string/settings_watch_title" />
        <Preference
            app:key="setup"
            app:icon="@drawable/ic_pref_info"
            app:title="@string/setup_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_alarms_category">
        <SwitchPreferenceCompat
            app:key="fail_safe"
            app:icon="@drawable/ic_pref_shield"
            app:title="@string/settings_fail_safe_title"
            app:summary="@string/settings_fail_safe_summary"
            app:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="phone_backup"
            app:icon="@drawable/ic_pref_phone"
            app:title="@string/settings_backup_title"
            app:summary="@string/settings_backup_summary"
            app:defaultValue="true" />
        <SeekBarPreference
            app:key="backup_delay"
            app:icon="@drawable/ic_pref_timer"
            app:dependency="phone_backup"
            app:title="@string/settings_backup_delay_title"
            app:defaultValue="10"
            app:min="0"
            android:max="30"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            app:key="expiry_hours"
            app:icon="@drawable/ic_pref_hourglass"
            app:title="@string/settings_expiry_title"
            app:summary="@string/settings_expiry_summary"
            app:defaultValue="12"
            app:min="0"
            android:max="48"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_tile_category">
        <Preference
            app:selectable="false"
            app:icon="@drawable/ic_pref_tile"
            app:title="@string/settings_tile_title"
            app:summary="@string/settings_tile_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/settings_appearance_category">
        <ListPreference
            app:key="timeline_side"
            app:icon="@drawable/ic_pref_side"
            app:title="@string/settings_timeline_side_title"
            app:entries="@array/timeline_side_entries"
            app:entryValues="@array/timeline_side_values"
            app:defaultValue="left"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
